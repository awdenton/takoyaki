[sub_resource type="CSharpScript" id="CSharpScript_7qkf3"]
script/source = "using Godot;

public partial class HUD : CanvasLayer
{
    [Signal]
    public delegate void NewGameEventHandler();

    [Signal]
    public delegate void ShuffleEventHandler();

    public override void _Ready()
    {
        GetNode<Button>(\"NewGameButton\").Pressed += OnNewGameButtonPressed;
        GetNode<Button>(\"ShuffleButton\").Pressed += OnShuffleButtonPressed;
    }

    private void OnNewGameButtonPressed()
    {
        EmitSignal(SignalName.NewGame);
    }

    private void OnShuffleButtonPressed()
    {
        EmitSignal(SignalName.Shuffle);
    }
}
"

